DATABASE_URL=postgresql+asyncpg://mabeyn_app:mabeyn_app@localhost:5432/mabeyn
ADMIN_DATABASE_URL=postgresql+asyncpg://mabeyn:mabeyn@localhost:5432/mabeyn
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters
LOG_LEVEL=INFO
LLM_MODEL=gpt-4.1-mini
LLM_MODEL_SMALL=gpt-4o-mini
JUDGE_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
WANDB_API_KEY=

# Optional tuning (the defaults are shown)
CACHE_ENABLED=true
APPROVAL_TTL_HOURS=72
CHAT_RATE_PER_CUSTOMER=20
CHAT_RATE_PER_KEY=300
CHAT_RATE_PER_TENANT=600
SESSION_RATE_PER_ADDRESS=20
SESSION_RATE_PER_KEY=60
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=5
# Origins that may call the API from a browser (comma separated, or * for any)
CORS_ALLOW_ORIGINS=*
# Password of the demo admin that `make demo` creates (read on the first run only)
DEMO_ADMIN_PASSWORD=demo-admin-password
# Set to true when the admin panel is served over HTTPS (marks its cookies secure)
COOKIE_SECURE=false
# Share of runs LangSmith records (0 to 1)
TRACING_SAMPLE_RATE=0.1
# Spend guard of the evaluation runners, in USD
EVAL_BUDGET_USD=7
